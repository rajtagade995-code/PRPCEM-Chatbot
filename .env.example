# PRPCEM College Assistant - Environment Configuration Example
# Copy this file to .env and configure values for production

# Secret key for Flask session security (generate a strong random key for production)
SECRET_KEY=prpcem-production-secure-key-replace-this-in-prod

# Admin Credentials for accessing /admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# Server Network Configuration
HOST=0.0.0.0
PORT=5000

# Optional: Custom database path if persistent volume is used
# DATABASE_PATH=/var/data/chatbot.db

# Flask Debug Mode (0 in production, 1 in development)
FLASK_DEBUG=0
